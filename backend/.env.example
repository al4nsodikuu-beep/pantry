# SERVER ONLY. Inject via your host's secret manager, not into source or Android.
PLAY_PACKAGE_NAME=
PLAY_PRODUCT_ID=premium
PLAY_MONTHLY_PLAN=monthly
PLAY_ANNUAL_PLAN=annual
FIREBASE_PROJECT_ID=
# Persistent disk path; never an ephemeral Cloud Run/container filesystem.
BILLING_DB_PATH=/data/subscriptions.sqlite3
# Generate using cryptography.fernet.Fernet.generate_key(); keep stable and backed up.
BILLING_ENCRYPTION_KEY=
# At least 32 random bytes expressed as a stable text secret. Do not rotate casually.
BILLING_BINDING_SECRET=
# Prefer attached Google Cloud workload identity / ADC. Do not copy private keys to the client.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
# Leave false until Play products, backend, AI services and license-test purchases are ready.
BILLING_ENABLED=false
